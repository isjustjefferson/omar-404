{
  "name": "omar404-qa",
  "version": "1.0.0",
  "private": true,
  "description": "Automação e evidências de teste do Omar-404",
  "scripts": {
    "env:check": "node scripts/check-env.js",
    "db:reset": "node scripts/reset-test-db.js",
    "test:api": "jest --config jest.config.js --selectProjects api",
    "test:unit": "jest --config jest.config.js --selectProjects unit",
    "test:events": "jest --config jest.config.js --selectProjects events",
    "test:bdd": "cucumber-js --config cucumber.js",
    "test:e2e": "cypress run --project cypress",
    "test:week5": "node scripts/run-week5.js",
    "test:week6:api": "jest --config jest.week6.api.config.js",
    "test:week6:unit": "jest --config jest.week6.unit.config.js",
    "test:week6:e2e": "cypress run --project cypress --config-file cypress.week6.config.js",
    "test:week6": "node scripts/run-week6.js"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "bcryptjs": "^3.0.3",
    "cypress": "^16.3.0",
    "dotenv": "^18.0.10",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "redis": "^6.3.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2"
  }
}
